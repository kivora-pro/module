{
	"name": "@kivora/react",
	"version": "0.1.0",
	"description": "Kivora UI components for React (compatible with Next.js)",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit",
		"clean": "rimraf dist"
	},
	"peerDependencies": {
		"framer-motion": ">=10",
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@kivora/core": "workspace:*",
		"@tailwindcss/cli": "^4.0.9",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/react-syntax-highlighter": "^15.5.13",
		"framer-motion": "^11.18.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rimraf": "^6.0.1",
		"tailwindcss": "^4.0.9",
		"tsup": "^8.3.5",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"date-fns": "^3.6.0",
		"react-day-picker": "^9.4.0",
		"react-select": "^5.10.2",
		"react-syntax-highlighter": "^16.1.1",
		"sonner": "^2.0.7",
		"swiper": "^12.1.2"
	}
}
