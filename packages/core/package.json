{
	"name": "@kivora/core",
	"version": "0.0.0",
	"description": "Shared logic, types and design tokens for Kivora",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"import": "./dist/tokens/index.js",
			"require": "./dist/tokens/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit",
		"clean": "rimraf dist"
	},
	"devDependencies": {
		"rimraf": "^6.0.1",
		"tsup": "^8.3.5",
		"typescript": "^5.7.3"
	}
}
